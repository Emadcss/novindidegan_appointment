# آدرس اتصال به PostgreSQL (فرمت: postgres://کاربر:رمز@میزبان:پورت/نام_دیتابیس)
# رمز را بدون کاراکترهای خاص (@ : / # ?) انتخاب کنید.
DATABASE_URL=postgres://kiosk_app:CHANGE_ME@localhost:5432/kiosk

# اختیاری: کلید رمزنگاری هویت بیمار (۶۴ کاراکتر هگز).
# اگر ندهید، در اولین اجرا فایل storage/secret.key خودکار ساخته می‌شود.
# ساخت کلید: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KIOSK_DATA_KEY=

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
